    <LangVersion>7.3</LangVersion>
    <RootNamespace>ErenshorCraftingExpanded</RootNamespace>
    <AssemblyName>ErenshorCraftingExpanded</AssemblyName>
    <OutputPath>bin\</OutputPath>
